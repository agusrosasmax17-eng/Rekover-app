rules_version = '2';

// =========================================================
// REKOVER — Reglas de seguridad de la base de datos (Firestore)
// Deciden quién puede leer o cambiar cada dato, aunque alguien
// intente saltearse la app. Se copian y pegan en:
// Firebase → Firestore Database → Reglas → Publicar.
//
// Quién es quién:
// - Administradora: la cuenta profesor@rekover.app (la misma de js/config.js). Ve todo.
// - Entrenador: tiene ficha en entrenadores/{su uid}. Ve y maneja solo sus alumnos.
// - Alumno: su ficha en alumnas/{id} tiene uid = su cuenta, y entrenadorUid = su
//   entrenador (vacío o sin campo = alumno de la administradora).
// =========================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() { return request.auth != null; }

    function esAdmin() {
      return logueado() && request.auth.token.get('email', '') == 'profesor@rekover.app';
    }

    function esEntrenador() {
      return logueado() && exists(/databases/$(database)/documents/entrenadores/$(request.auth.uid));
    }

    function alumna(alumnaId) {
      return get(/databases/$(database)/documents/alumnas/$(alumnaId)).data;
    }

    // La persona que ingresó es el alumno dueño de esa ficha
    function esLaAlumna(alumnaId) {
      return logueado() && alumna(alumnaId).uid == request.auth.uid;
    }

    // Entrenador de ese alumno ('' = administradora)
    function entrenadorDe(alumnaId) {
      return alumna(alumnaId).get('entrenadorUid', '');
    }

    // Puede manejar a ese alumno: la administradora o su entrenador
    function puedeManejar(alumnaId) {
      return esAdmin() || (logueado() && entrenadorDe(alumnaId) == request.auth.uid);
    }

    // Qué cuenta usa cada DNI de alumno para ingresar. Se puede consultar un DNI puntual
    // (hace falta antes de ingresar), pero nadie puede ver la lista completa.
    match /accesos/{dni} {
      allow get: if true;
      allow list: if false;
      allow create: if esAdmin() || (esEntrenador() && request.resource.data.entrenadorUid == request.auth.uid);
      allow update: if esAdmin() || (esEntrenador()
        && resource.data.get('entrenadorUid', '') == request.auth.uid
        && request.resource.data.entrenadorUid == request.auth.uid);
      allow delete: if esAdmin();
    }

    // Lo mismo para los entrenadores (solo la administradora los crea)
    match /accesosEntrenadores/{dni} {
      allow get: if true;
      allow list: if false;
      allow write: if esAdmin();
    }

    // Ficha de cada entrenador: la crea la administradora. El entrenador solo lee la suya
    // y lo único que puede cambiar es marcar que ya creó su contraseña.
    match /entrenadores/{entrenadorUid} {
      allow read: if esAdmin() || (logueado() && request.auth.uid == entrenadorUid);
      allow create, delete: if esAdmin();
      allow update: if esAdmin() || (
        logueado() && request.auth.uid == entrenadorUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['debeCambiarClave', 'codigoInicial'])
        && request.resource.data.debeCambiarClave == false
      );

      // Notificaciones para el entrenador: las mandan sus alumnos
      match /avisos/{avisoId} {
        allow read, update, delete: if esAdmin() || (logueado() && request.auth.uid == entrenadorUid);
        allow create: if request.resource.data.keys().hasOnly(['alumnaId', 'texto', 'fecha', 'leido'])
          && request.resource.data.leido == false
          && esLaAlumna(request.resource.data.alumnaId)
          && entrenadorDe(request.resource.data.alumnaId) == entrenadorUid;
      }
    }

    // Ficha de cada alumno (la colección se llama "alumnas" por los datos ya cargados).
    // La administradora ve y cambia todo. Cada entrenador, solo sus alumnos.
    // Cada alumno solo lee la suya, y solo puede cambiar su rutina y marcar que ya creó su contraseña.
    match /alumnas/{alumnaId} {
      allow read: if esAdmin()
        || (logueado() && resource.data.uid == request.auth.uid)
        || (logueado() && resource.data.entrenadorUid == request.auth.uid);
      allow create: if esAdmin() || (esEntrenador() && request.resource.data.entrenadorUid == request.auth.uid);
      allow delete: if esAdmin() || (esEntrenador() && resource.data.entrenadorUid == request.auth.uid);
      allow update: if esAdmin()
        || (esEntrenador()
          && resource.data.entrenadorUid == request.auth.uid
          && request.resource.data.entrenadorUid == request.auth.uid)
        || (logueado()
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['debeCambiarClave', 'codigoInicial', 'rutinas', 'cambios'])
          && request.resource.data.debeCambiarClave == false);

      // Lo que el alumno registra cada día
      match /registros/{registroId} {
        allow read, write: if puedeManejar(alumnaId) || esLaAlumna(alumnaId);
      }

      // Notificaciones para el alumno: las crea su entrenador; el alumno solo las marca como leídas
      match /avisos/{avisoId} {
        allow read: if puedeManejar(alumnaId) || esLaAlumna(alumnaId);
        allow create, delete: if puedeManejar(alumnaId);
        allow update: if esLaAlumna(alumnaId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leido']);
      }
    }

    // Notificaciones para la administradora: las mandan los alumnos que no tienen entrenador
    match /avisosProfe/{avisoId} {
      allow read, update, delete: if esAdmin();
      allow create: if request.resource.data.keys().hasOnly(['alumnaId', 'texto', 'fecha', 'leido'])
        && request.resource.data.leido == false
        && esLaAlumna(request.resource.data.alumnaId)
        && entrenadorDe(request.resource.data.alumnaId) == '';
    }

    // Encuestas: cada alumno crea las suyas y solo ve las suyas; su entrenador ve las de sus
    // alumnos; la administradora ve todas
    match /encuestas/{encuestaId} {
      allow read: if esAdmin()
        || (logueado() && resource.data.uid == request.auth.uid)
        || (logueado() && resource.data.entrenadorUid == request.auth.uid);
      allow create: if logueado()
        && request.resource.data.uid == request.auth.uid
        && esLaAlumna(request.resource.data.alumnaId)
        && request.resource.data.entrenadorUid == entrenadorDe(request.resource.data.alumnaId);
      allow update, delete: if esAdmin();
    }

    // Ejercicios propios: "ejercicios" es de la administradora y "ejercicios_{uid}" de cada
    // entrenador. Cualquiera que ingresó los puede leer (los alumnos los usan para armar su rutina).
    match /config/{documento} {
      allow read: if logueado();
      allow write: if esAdmin() || (esEntrenador() && documento == 'ejercicios_' + request.auth.uid);
    }

    // Todo lo demás está cerrado
  }
}
